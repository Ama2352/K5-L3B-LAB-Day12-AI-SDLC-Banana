/chonoi/ui/             @handle-ui @handle-du-phong-3
/chonoi/live.py        @handle-ui @handle-du-phong-3
/chonoi/web/           @handle-ui @handle-du-phong-3
/tests/                 @handle-qa @handle-du-phong-4
/game.contract.json     @handle-integrator @handle-du-phong-4
/docs/contracts/        @handle-integrator @handle-du-phong-4
/.github/               @handle-integrator @handle-qa
